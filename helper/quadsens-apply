#!/usr/bin/python3 -I
"""Privileged helper for QuadSens: write values to the yeetmouse module parameters.

Usage: quadsens-apply XPOS XNEG YPOS YNEG
       quadsens-apply accel MODE SWITCH ACCELERATION EXPONENT MIDPOINT MOTIVITY

Meant to be run through pkexec. It takes no options, reads no environment and
never touches any path but the fixed parameter files of the module.

First form: exactly four plain decimal numbers between 0.1 and 10, written to
the four DirScale* parameters, then 1 to "update".

Second form: an acceleration curve. MODE is one of 0, 1, 2, 3, 6, 7 (off,
linear, power, classic, natural, jump), SWITCH is 0 or 1 (UseSmoothing), the
four numbers are in fixed notation with exactly ten decimals. The helper does
not trust its caller: it checks the same limits QuadSens checks before it
writes (ranges per mode, no internal point of the curve beyond 100000
counts/ms, and so on; see docs/accel-modes.md, "Rules the editor enforces"),
because the module's fixed-point code divides without range checks. It also
refuses when the module is currently set to something QuadSens does not edit.
It writes the four numbers and the mode, then UseSmoothing, then "update",
in that order.
"""

import math
import os
import re
import sys

PARAMS_DIR = "/sys/module/yeetmouse/parameters"
PARAM_NAMES = ("DirScaleXPos", "DirScaleXNeg", "DirScaleYPos", "DirScaleYNeg")
SCALE_MIN = 0.1
SCALE_MAX = 10.0
# Digits with an optional fraction only: no sign, exponent, whitespace, nan or inf.
_NUMBER = re.compile(r"[0-9]{1,2}(\.[0-9]{1,9})?")


def parse_args(args: list[str]) -> list[str]:
    """Return the four values as normalised decimal strings or raise ValueError."""
    if len(args) != 4:
        raise ValueError("expected exactly four values (XPos XNeg YPos YNeg)")
    result = []
    for name, text in zip(PARAM_NAMES, args):
        if not isinstance(text, str) or _NUMBER.fullmatch(text) is None:
            raise ValueError("%s: not a plain decimal number" % name)
        value = float(text)
        if not SCALE_MIN <= value <= SCALE_MAX:
            raise ValueError("%s: outside %s..%s" % (name, SCALE_MIN, SCALE_MAX))
        result.append("%.6f" % value)
    return result


# ---- acceleration ---------------------------------------------------------------

ACCEL_SLOTS = ("Acceleration", "Exponent", "Midpoint", "Motivity")
ACCEL_NEUTRAL = (("Offset", 0.0), ("InputCap", 0.0), ("OutputCap", 0.0), ("PreScale", 1.0))
ACCEL_MODES = ("0", "1", "2", "3", "6", "7")
# What a slot must hold when the mode does not use it.
ACCEL_FILL = (1.0, 2.0, 1.0, 1.5)
SAFE_LOG = math.log(1.0e5)
# Fixed notation, a leading digit, exactly ten decimals: what the module's
# parser reads reliably. No sign, no exponent.
_FIXED = re.compile(r"[0-9]{1,2}\.[0-9]{10}")


def _between(name, value, low, high):
    if not low <= value <= high:
        raise ValueError("%s: outside %s..%s" % (name, low, high))


def _fill(name, value, expected):
    if value != expected:
        raise ValueError("%s: must be %s for this mode" % (name, expected))


def _point(numerator, inverse_exponent, scale):
    """log of the speed (numerator ** inverse_exponent / scale)."""
    return math.log(numerator) * inverse_exponent - math.log(scale)


def check_accel(mode, switch, a, e, m, v):
    """Raise ValueError unless this is a curve QuadSens may write. Numbers are floats."""
    fa, fe, fm, fv = ACCEL_FILL
    if mode == "0":
        if switch != "0":
            raise ValueError("UseSmoothing must be 0 for mode 0")
        _fill("Acceleration", a, fa), _fill("Exponent", e, fe)
        _fill("Midpoint", m, fm), _fill("Motivity", v, fv)
    elif mode in ("1", "3"):
        _between("Acceleration", a, 1e-4, 1.0 if mode == "1" else 2.0)
        if mode == "1":
            _fill("Exponent", e, fe)
        else:
            _between("Exponent", e, 1.01, 5.0)
        _fill("Motivity", v, fv)
        if switch == "0":
            _fill("Midpoint", m, fm)
            # Without a cap the curve must not grow beyond what fixed point holds.
            if 1 + math.pow(a * 1000.0, e - 1) > 1.0e5:
                raise ValueError("the curve grows too large at high speed")
        else:
            _between("Midpoint", m, 0.1, 10.0)
            if m != 1 and _point(abs(m - 1) / e, 1 / (e - 1), a) > SAFE_LOG:
                raise ValueError("the cap point lies beyond 100000 counts/ms")
    elif mode == "2":
        _between("Acceleration", a, 1e-3, 5.0)
        _between("Exponent", e, 0.01, 1.0)
        _between("Midpoint", m, 0.0, 5.0)
        if m > 99 * a * e:
            raise ValueError("Midpoint: too large for this scale and exponent")
        if m > 0 and _point(m / (e + 1), 1 / e, a) > SAFE_LOG:
            raise ValueError("the offset point lies beyond 100000 counts/ms")
        if switch == "0":
            _fill("Motivity", v, fv)
        else:
            _between("Motivity", v, 0.0, 10.0)
            if v <= m:
                raise ValueError("Motivity: the cap must be above the offset")
            if _point(v / (e + 1), 1 / e, a) > SAFE_LOG:
                raise ValueError("the cap point lies beyond 100000 counts/ms")
    elif mode == "6":
        _between("Acceleration", a, 1e-3, 5.0)
        _between("Exponent", e, 0.01, 8.0)
        if abs(e - 1) < 0.01 - 1e-12:
            raise ValueError("Exponent: too close to 1")
        _between("Midpoint", m, 0.0, 50.0)
        _fill("Motivity", v, fv)
    elif mode == "7":
        _between("Midpoint", m, 0.1, 50.0)
        _between("Acceleration", a, 0.01, 10.0)
        _between("Exponent", e, 0.0, 1.0)
        _fill("Motivity", v, fv)
    else:
        raise ValueError("mode: not one of %s" % ", ".join(ACCEL_MODES))


def parse_accel(args: list[str]) -> list[tuple[str, str]]:
    """Return the writes (parameter, text) in the order to make them, or raise ValueError."""
    if len(args) != 6:
        raise ValueError("expected MODE SWITCH and four numbers")
    mode, switch = args[0], args[1]
    if mode not in ACCEL_MODES:
        raise ValueError("mode: not one of %s" % ", ".join(ACCEL_MODES))
    if switch not in ("0", "1"):
        raise ValueError("switch: not 0 or 1")
    for name, text in zip(ACCEL_SLOTS, args[2:]):
        if not isinstance(text, str) or _FIXED.fullmatch(text) is None:
            raise ValueError("%s: not a number with exactly ten decimals" % name)
    check_accel(mode, switch, *(float(text) for text in args[2:]))
    writes = list(zip(ACCEL_SLOTS, args[2:]))
    return [*writes, ("AccelerationMode", mode), ("UseSmoothing", switch), ("update", "1")]


def _read(path: str) -> str:
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    try:
        return os.read(fd, 256).decode("ascii", "replace").strip()
    finally:
        os.close(fd)


def check_current(params_dir: str) -> None:
    """Refuse when the module is set to something QuadSens does not edit."""
    mode = _read(os.path.join(params_dir, "AccelerationMode"))
    if mode not in ACCEL_MODES:
        raise ValueError("the module is in mode %s, which QuadSens does not edit" % mode[:8])
    for name, neutral in ACCEL_NEUTRAL:
        text = _read(os.path.join(params_dir, name))
        try:
            value = float(text)
        except ValueError:
            raise ValueError("%s could not be read" % name) from None
        if not abs(value - neutral) <= 1e-9:
            raise ValueError("%s is in use; QuadSens does not edit the curve then" % name)


def main_accel(args: list[str], params_dir: str) -> int:
    try:
        writes = parse_accel(args)
    except (ValueError, OverflowError, ZeroDivisionError) as exc:
        print("quadsens-apply: %s" % exc, file=sys.stderr)
        return 2
    if not os.path.isdir(params_dir):
        print("quadsens-apply: yeetmouse module is not loaded", file=sys.stderr)
        return 3
    try:
        check_current(params_dir)
    except ValueError as exc:
        print("quadsens-apply: not written: %s" % exc, file=sys.stderr)
        return 5
    except OSError as exc:
        print("quadsens-apply: read failed: %s" % exc, file=sys.stderr)
        return 4
    try:
        for name, text in writes:
            _write(os.path.join(params_dir, name), text + "\n")
    except OSError as exc:
        print("quadsens-apply: write failed: %s" % exc, file=sys.stderr)
        return 4
    return 0


def _write(path: str, text: str) -> None:
    fd = os.open(path, os.O_WRONLY | os.O_TRUNC | os.O_NOFOLLOW)
    try:
        os.write(fd, text.encode("ascii"))
    finally:
        os.close(fd)


def main(args: list[str], params_dir: str = PARAMS_DIR) -> int:
    if args[:1] == ["accel"]:
        return main_accel(args[1:], params_dir)
    try:
        values = parse_args(args)
    except ValueError as exc:
        print("quadsens-apply: %s" % exc, file=sys.stderr)
        return 2
    if not os.path.isdir(params_dir):
        print("quadsens-apply: yeetmouse module is not loaded", file=sys.stderr)
        return 3
    try:
        for name, value in zip(PARAM_NAMES, values):
            _write(os.path.join(params_dir, name), value + "\n")
        _write(os.path.join(params_dir, "update"), "1\n")
    except OSError as exc:
        print("quadsens-apply: write failed: %s" % exc, file=sys.stderr)
        return 4
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
